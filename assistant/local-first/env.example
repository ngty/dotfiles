# local-first/.env

# --- External API Access Tokens ---
GEMINI_API_KEY=your_actual_gemini_api_key_here
DEEPSEEK_API_KEY=your_actual_deepseek_api_key_here

# --- Ollama Upstream Platform ---
OLLAMA_REPO=ollama/ollama
OLLAMA_TAG=0.30.6
OLLAMA_SHA=54da8ddbd012894cddade896d50ddf881fe4faf1eb472453b31b94d128d0bb73
OLLAMA_API_URL=https://hub.docker.com/v2/repositories/ollama/ollama/tags/${OLLAMA_TAG}/
OLLAMA_INFO_URL=https://hub.docker.com/r/ollama/ollama/tags?name=${OLLAMA_TAG}

# --- LiteLLM Upstream Platform ---
LITELLM_REPO=ghcr.io/berriai/litellm
LITELLM_TAG=v1.84.3
LITELLM_SHA=a24eb7ad0e563e6edbda0761ee8384b10a3f0a9bdcbcd3b36dfdadb9c9ca059f
LITELLM_API_URL=https://api.github.com/orgs/berriai/packages/container/litellm/versions
LITELLM_INFO_URL=https://github.com/berriai/litellm/pkgs/container/litellm/versions?filters%5Bversion_type%5D=tagged